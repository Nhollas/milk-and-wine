{
  "B1": {
    "then": "Prints `unknown task: <task>`, and exits `1`",
    "mutants": [
      {
        "breaks": "The unknown-task message no longer names the task given.",
        "file": "tools/benchmark/check.ts",
        "find": [
          "  if (!isDirectory(taskFolder)) return { exitCode: 1, output: `unknown task: ${task}\\n` };"
        ],
        "replace": [
          "  if (!isDirectory(taskFolder)) return { exitCode: 1, output: \"unknown task\\n\" };"
        ]
      },
      {
        "breaks": "An unknown task exits 0 instead of 1.",
        "file": "tools/benchmark/check.ts",
        "find": [
          "  if (!isDirectory(taskFolder)) return { exitCode: 1, output: `unknown task: ${task}\\n` };"
        ],
        "replace": [
          "  if (!isDirectory(taskFolder)) return { exitCode: 0, output: `unknown task: ${task}\\n` };"
        ]
      }
    ]
  },
  "B2": {
    "then": "Prints `<task> is not valid:` and each missing part, and exits `1`",
    "mutants": [
      {
        "breaks": "The header line `<task> is not valid:` is no longer printed.",
        "file": "tools/benchmark/check.ts",
        "find": ["    return { exitCode: 1, output: `${task} is not valid:\\n${lines}` };"],
        "replace": ["    return { exitCode: 1, output: lines };"]
      },
      {
        "breaks": "Only the first missing part is listed instead of each one.",
        "file": "tools/benchmark/check.ts",
        "find": ["    const lines = missing.map(({ part }) => `  missing ${part}\\n`).join(\"\");"],
        "replace": [
          "    const lines = missing.slice(0, 1).map(({ part }) => `  missing ${part}\\n`).join(\"\");"
        ]
      },
      {
        "breaks": "A task with missing parts exits 0 instead of 1.",
        "file": "tools/benchmark/check.ts",
        "find": ["    return { exitCode: 1, output: `${task} is not valid:\\n${lines}` };"],
        "replace": ["    return { exitCode: 0, output: `${task} is not valid:\\n${lines}` };"]
      },
      {
        "breaks": "A missing solution is never noticed because it is not among the parts checked.",
        "file": "tools/benchmark/check.ts",
        "find": [
          "  { part: \"hidden tests\", path: \"tests\" },",
          "  { part: \"solution\", path: \"solution\" },"
        ],
        "replace": ["  { part: \"hidden tests\", path: \"tests\" },"]
      },
      {
        "breaks": "A missing ticket is not noticed because the tickets folder is not checked.",
        "file": "tools/benchmark/check.ts",
        "find": [
          "  { part: \"ticket\", path: \"tickets\" },",
          "  { part: \"starter code\", path: \"starter\" },"
        ],
        "replace": ["  { part: \"starter code\", path: \"starter\" },"]
      },
      {
        "breaks": "An empty folder (no tickets, starter code, tests or solution) counts as present.",
        "file": "tools/benchmark/check.ts",
        "find": ["  return !statSync(path).isDirectory() || readdirSync(path).length > 0;"],
        "replace": ["  return true;"]
      },
      {
        "breaks": "A missing spec file is not reported because the spec is not among the parts checked.",
        "file": "tools/benchmark/check.ts",
        "find": [
          "  { part: \"spec\", path: \"spec.md\" },",
          "  { part: \"issue\", path: \"issue.md\" },"
        ],
        "replace": ["  { part: \"issue\", path: \"issue.md\" },"]
      }
    ]
  },
  "B3": {
    "then": "Reports `fails on the solution` with the test's title, and exits `1`",
    "mutants": [
      {
        "breaks": "The solution's failing tests are not the ones reported: passing tests are listed instead.",
        "file": "tools/benchmark/check.ts",
        "find": ["      .filter(({ passed }) => !passed)"],
        "replace": ["      .filter(({ passed }) => passed)"]
      },
      {
        "breaks": "The `fails on the solution` report names only the scenario ID, not the test's title.",
        "file": "tools/benchmark/check.ts",
        "find": ["      .map(({ title }) => `fails on the solution  ${title}`),"],
        "replace": ["      .map(({ title }) => `fails on the solution  ${idOf(title)}`),"]
      },
      {
        "breaks": "The solution's hidden tests are run against the starter code, so a test failing only on the solution goes unnoticed.",
        "file": "tools/benchmark/check.ts",
        "find": ["  const solutionResults = hiddenTests.run(taskFolder, \"solution\");"],
        "replace": ["  const solutionResults = hiddenTests.run(taskFolder, \"starter\");"]
      },
      {
        "breaks": "A skipped or otherwise non-passing hidden test is counted as passing, so it never fails on the solution.",
        "file": "tools/benchmark/hidden-tests.ts",
        "find": ["            passed: status === \"passed\","],
        "replace": ["            passed: status !== \"failed\","]
      }
    ]
  },
  "B4": {
    "then": "Reports `passes on the starter code` with the test's title, and exits `1`",
    "mutants": [
      {
        "breaks": "Every starter-code result is reported, including tests that fail there as they should.",
        "file": "tools/benchmark/check.ts",
        "find": ["      .filter(({ passed }) => passed)"],
        "replace": ["      .filter(() => true)"]
      },
      {
        "breaks": "The `passes on the starter code` report names only the scenario ID, not the test's title.",
        "file": "tools/benchmark/check.ts",
        "find": ["      .map(({ title }) => `passes on the starter code  ${title}`),"],
        "replace": ["      .map(({ title }) => `passes on the starter code  ${idOf(title)}`),"]
      },
      {
        "breaks": "The starter-code check runs the hidden tests against the solution, so a test passing on the starter code goes unnoticed.",
        "file": "tools/benchmark/check.ts",
        "find": ["  const starterResults = hiddenTests.run(taskFolder, \"starter\");"],
        "replace": ["  const starterResults = hiddenTests.run(taskFolder, \"solution\");"]
      },
      {
        "breaks": "The report says `passes on the starter` instead of `passes on the starter code`.",
        "file": "tools/benchmark/check.ts",
        "find": ["      .map(({ title }) => `passes on the starter code  ${title}`),"],
        "replace": ["      .map(({ title }) => `passes on the starter  ${title}`),"]
      }
    ]
  },
  "B5": {
    "then": "Reports `no hidden test` with the ID, and exits `1`",
    "mutants": [
      {
        "breaks": "Scenarios that do have a hidden test are reported instead of those that lack one.",
        "file": "tools/benchmark/check.ts",
        "find": [
          "    ...scenarioIds.filter((id) => !testedIds.has(id)).map((id) => `no hidden test  ${id}`),"
        ],
        "replace": [
          "    ...scenarioIds.filter((id) => testedIds.has(id)).map((id) => `no hidden test  ${id}`),"
        ]
      },
      {
        "breaks": "Only the first hidden test counts toward covering scenarios, so later scenarios are wrongly reported as untested.",
        "file": "tools/benchmark/check.ts",
        "find": ["  const testedIds = new Set(solutionResults.map(({ title }) => idOf(title)));"],
        "replace": [
          "  const testedIds = new Set(solutionResults.slice(0, 1).map(({ title }) => idOf(title)));"
        ]
      },
      {
        "breaks": "The `no hidden test` report does not say which scenario ID lacks a test.",
        "file": "tools/benchmark/check.ts",
        "find": [
          "    ...scenarioIds.filter((id) => !testedIds.has(id)).map((id) => `no hidden test  ${id}`),"
        ],
        "replace": [
          "    ...scenarioIds.filter((id) => !testedIds.has(id)).map(() => \"no hidden test\"),"
        ]
      },
      {
        "breaks": "A scenario counts as tested when any hidden test title merely starts with its ID text, so B1 is covered by a B10 test.",
        "file": "tools/benchmark/check.ts",
        "find": [
          "    ...scenarioIds.filter((id) => !testedIds.has(id)).map((id) => `no hidden test  ${id}`),"
        ],
        "replace": [
          "    ...scenarioIds",
          "      .filter((id) => !solutionResults.some(({ title }) => title.startsWith(id)))",
          "      .map((id) => `no hidden test  ${id}`),"
        ]
      }
    ]
  },
  "B6": {
    "then": "Reports `unknown-id` with the test's title, and exits `1`",
    "mutants": [
      {
        "breaks": "Tests whose ID the spec does have are reported as unknown, and unknown ones are not.",
        "file": "tools/benchmark/check.ts",
        "find": ["      .filter(({ title }) => !scenarioIds.includes(idOf(title)))"],
        "replace": ["      .filter(({ title }) => scenarioIds.includes(idOf(title)))"]
      },
      {
        "breaks": "An ID that merely begins with a spec ID, such as B100 against B10, is accepted as known.",
        "file": "tools/benchmark/check.ts",
        "find": ["      .filter(({ title }) => !scenarioIds.includes(idOf(title)))"],
        "replace": ["      .filter(({ title }) => !scenarioIds.some((id) => title.startsWith(id)))"]
      },
      {
        "breaks": "The `unknown-id` report names only the ID, not the test's title.",
        "file": "tools/benchmark/check.ts",
        "find": ["      .map(({ title }) => `unknown-id  ${title}`),"],
        "replace": ["      .map(({ title }) => `unknown-id  ${idOf(title)}`),"]
      },
      {
        "breaks": "The report uses the label `unknown id` instead of `unknown-id`.",
        "file": "tools/benchmark/check.ts",
        "find": ["      .map(({ title }) => `unknown-id  ${title}`),"],
        "replace": ["      .map(({ title }) => `unknown id  ${title}`),"]
      }
    ]
  },
  "B7": {
    "then": "Prints `ok`, the number of scenarios and of hidden tests, then `bench:check passed`, and exits `0`",
    "mutants": [
      {
        "breaks": "The count of hidden tests is wrong (off by one).",
        "file": "tools/benchmark/check.ts",
        "find": [
          "    output: `ok: ${scenarios.length} scenarios, ${solutionResults.length} hidden tests\\nbench:check passed\\n`,"
        ],
        "replace": [
          "    output: `ok: ${scenarios.length} scenarios, ${solutionResults.length + 1} hidden tests\\nbench:check passed\\n`,"
        ]
      },
      {
        "breaks": "The number of scenarios reported is the number of hidden tests instead.",
        "file": "tools/benchmark/check.ts",
        "find": [
          "    output: `ok: ${scenarios.length} scenarios, ${solutionResults.length} hidden tests\\nbench:check passed\\n`,"
        ],
        "replace": [
          "    output: `ok: ${solutionResults.length} scenarios, ${solutionResults.length} hidden tests\\nbench:check passed\\n`,"
        ]
      },
      {
        "breaks": "The final `bench:check passed` line is not printed.",
        "file": "tools/benchmark/check.ts",
        "find": [
          "    output: `ok: ${scenarios.length} scenarios, ${solutionResults.length} hidden tests\\nbench:check passed\\n`,"
        ],
        "replace": [
          "    output: `ok: ${scenarios.length} scenarios, ${solutionResults.length} hidden tests\\n`,"
        ]
      },
      {
        "breaks": "A valid task exits 1 instead of 0.",
        "file": "tools/benchmark/check.ts",
        "find": ["    exitCode: 0,"],
        "replace": ["    exitCode: 1,"]
      },
      {
        "breaks": "The `ok` word is missing from the output.",
        "file": "tools/benchmark/check.ts",
        "find": [
          "    output: `ok: ${scenarios.length} scenarios, ${solutionResults.length} hidden tests\\nbench:check passed\\n`,"
        ],
        "replace": [
          "    output: `${scenarios.length} scenarios, ${solutionResults.length} hidden tests\\nbench:check passed\\n`,"
        ]
      }
    ]
  },
  "B26": {
    "then": "Prints `usage: pnpm bench:check <task>`, and exits `1`",
    "mutants": [
      {
        "breaks": "With no task name the command exits 0 instead of 1.",
        "file": "tools/benchmark/check.ts",
        "find": ["    return { exitCode: 1, output: \"usage: pnpm bench:check <task>\\n\" };"],
        "replace": ["    return { exitCode: 0, output: \"usage: pnpm bench:check <task>\\n\" };"]
      },
      {
        "breaks": "With no task name the usage line is not printed.",
        "file": "tools/benchmark/check.ts",
        "find": ["    return { exitCode: 1, output: \"usage: pnpm bench:check <task>\\n\" };"],
        "replace": ["    return { exitCode: 1, output: \"\" };"]
      },
      {
        "breaks": "The usage line names the wrong command (`bench:run` instead of `bench:check`).",
        "file": "tools/benchmark/check.ts",
        "find": ["    return { exitCode: 1, output: \"usage: pnpm bench:check <task>\\n\" };"],
        "replace": ["    return { exitCode: 1, output: \"usage: pnpm bench:run <task>\\n\" };"]
      }
    ]
  }
}
