{
  "name": "milk-and-wine",
  "private": true,
  "description": "An experimental take on spec-driven development, separating short-lived GitHub issues (milk) from lasting behaviour specs (wine).",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "start:loans": "node src/loans/main.ts",
    "start:reminders": "node src/reminders/main.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "test": "vitest run",
    "mutation": "stryker run",
    "check": "pnpm lint && pnpm format:check && pnpm knip && pnpm test",
    "bench:check": "node tools/benchmark/check.ts",
    "bench:run": "node tools/benchmark/run.ts",
    "spec:mutants": "node tools/spec-mutants/replay.ts",
    "spec:mutants:check": "node tools/spec-mutants/check.ts",
    "eval:check": "node .claude/skills/intent-judge/evals/tools/check-cases.ts",
    "eval:judge": "claude plugin eval .claude/skills/intent-judge --scaffold --ablation none --no-publish --trust-plugin -j 4 --threshold 0.95 --output-dir .claude/skills/intent-judge/evals/results/$(git rev-parse --short HEAD)-$(date -u +%Y-%m-%dT%H-%M-%SZ)"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "hono": "4.13.7",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.4",
    "husky": "9.1.7",
    "knip": "6.42.1",
    "lint-staged": "17.6.0",
    "msw": "2.15.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,jsonc,yaml,yml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=24 <25",
      "onFail": "download"
    }
  }
}
