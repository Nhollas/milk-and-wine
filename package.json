{
  "name": "sdd-example",
  "private": true,
  "description": "A small library-loans service that demonstrates spec-driven development.",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "start:loans": "node src/loans/main.ts",
    "start:reminders": "node src/reminders/main.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "test": "vitest run --project '!smoke'",
    "test:smoke": "vitest run --project smoke",
    "spec:status": "node tools/spec-trace/status.ts",
    "spec:check": "node tools/spec-trace/check.ts",
    "check": "pnpm lint && pnpm format:check && pnpm knip && pnpm test && pnpm spec:check"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "hono": "4.13.7",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.4",
    "husky": "9.1.7",
    "knip": "6.42.1",
    "lint-staged": "17.6.0",
    "msw": "2.15.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,jsonc,yaml,yml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=24 <25",
      "onFail": "download"
    }
  }
}
