{
  "name": "sdd-example",
  "private": true,
  "description": "A small library-loans service that demonstrates spec-driven development.",
  "type": "module",
  "scripts": {
    "start:loans": "node src/loans/main.ts",
    "start:reminders": "node src/reminders/main.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "spec:status": "node tools/spec-trace/status.ts",
    "spec:check": "node tools/spec-trace/check.ts",
    "check": "pnpm typecheck && pnpm test && pnpm spec:check"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "hono": "4.13.7",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "msw": "2.15.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "packageManager": "pnpm@12.3.4"
}
