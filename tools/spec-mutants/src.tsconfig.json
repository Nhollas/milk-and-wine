{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowUnreachableCode": true
  },
  "include": ["../../src/**/*.ts"],
  "exclude": [
    "../../src/tests/**",
    "../../src/**/*.test.ts",
    "../../src/**/*.fixtures.ts",
    "../../src/**/node_modules/**"
  ]
}
