{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["./tools/conventions/conventions-plugin.ts"],
  "plugins": ["typescript", "unicorn", "oxc", "import", "node", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    "max-lines-per-function": "off",
    "no-await-in-loop": "off",
    "require-await": "off",
    "oxc/no-map-spread": "off",
    "typescript/no-confusing-void-expression": [
      "error",
      {
        "ignoreArrowShorthand": true
      }
    ],
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/require-await": "off",
    "typescript/strict-boolean-expressions": [
      "error",
      {
        "allowNullableString": true
      }
    ],
    "unicorn/no-useless-undefined": "off",
    "vitest/no-conditional-in-test": "off",
    "vitest/warn-todo": "off",
    "vitest/no-standalone-expect": [
      "error",
      {
        "additionalTestBlockFunctions": ["test"]
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["msw", "msw/*", "**/http-interceptor.ts"],
            "message": "Only integration tests, system tests and tests/support/ intercept HTTP. Service tests use in-memory fakes of our clients."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["tests/support/**", "**/*.integration.test.ts", "**/*.system.test.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/**/*.ts"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "fetch",
            "message": "Call fetch only from a *-client.ts module, so the rest of the code can be tested without HTTP."
          }
        ]
      }
    },
    {
      "files": ["src/**/*-client.ts"],
      "rules": {
        "no-restricted-globals": "off"
      }
    },
    {
      "files": ["**/*.fixtures.ts"],
      "rules": {
        "no-empty-pattern": "off"
      }
    },
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "typescript/no-unsafe-assignment": "off"
      }
    },
    {
      "files": ["src/**", "tests/**", "tools/**"],
      "rules": {
        "conventions/file-names": "error",
        "conventions/helper-placement": "error",
        "conventions/interceptor-use-placement": "error",
        "conventions/max-comment-lines": "error",
        "conventions/support-modules": "error",
        "conventions/test-imports": "error",
        "conventions/test-placement": "error"
      }
    }
  ],
  "ignorePatterns": ["node_modules/**"]
}
