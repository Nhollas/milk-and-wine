{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "node", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "env": { "node": true, "es2024": true },
  "rules": {
    "max-lines-per-function": "off",
    "no-await-in-loop": "off",
    "require-await": "off",
    "oxc/no-map-spread": "off",
    "typescript/no-confusing-void-expression": ["error", { "ignoreArrowShorthand": true }],
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/require-await": "off",
    "typescript/strict-boolean-expressions": ["error", { "allowNullableString": true }],
    "unicorn/no-useless-undefined": "off",
    "vitest/no-conditional-in-test": "off",
    "vitest/no-standalone-expect": ["error", { "additionalTestBlockFunctions": ["test"] }]
  },
  "overrides": [
    {
      "files": ["**/*.fixtures.ts"],
      "rules": { "no-empty-pattern": "off" }
    },
    {
      "files": ["**/*.test.ts"],
      "rules": { "typescript/no-unsafe-assignment": "off" }
    }
  ],
  "ignorePatterns": ["node_modules/**"]
}
