{
  "extends": ["@tsconfig/node24", "@tsconfig/strictest"],
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "tools/**/*.ts",
    "*.config.ts",
    ".claude/**/*.ts",
    "evals/**/*.ts"
  ],
  "exclude": ["node_modules", "evals/*/judge-*/**"]
}
